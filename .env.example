# Copy to .env, then replace every placeholder. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medium_clone?sslmode=require"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medium_clone_test?sslmode=require"
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"
JWT_ISSUER="medium-clone-api"
JWT_AUDIENCE="medium-clone-web"
PORT=3000
